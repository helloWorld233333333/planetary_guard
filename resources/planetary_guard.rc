#include <windows.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "planetary_guard.manifest"

1 VERSIONINFO
FILEVERSION 0,1,7,0
PRODUCTVERSION 0,1,7,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "Planetary Guard contributors\0"
            VALUE "FileDescription", "Planetary Guard lightweight Windows Dock\0"
            VALUE "FileVersion", "0.1.7.0\0"
            VALUE "InternalName", "planetary_guard.exe\0"
            VALUE "OriginalFilename", "planetary_guard.exe\0"
            VALUE "ProductName", "Planetary Guard\0"
            VALUE "ProductVersion", "0.1.7\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
